{
  "schemaVersion": 1,
  "id": "delormous.volumio",
  "name": "Volumio",
  "version": "0.1.0",
  "author": "delormous",
  "license": "MIT",
  "description": "Control Volumio playback, artwork and volume from the Omarchy bar.",
  "kinds": ["service", "bar-widget"],
  "entryPoints": {"service": "Service.qml", "barWidget": "BarWidget.qml"},
  "barWidget": {
    "displayName": "Volumio",
    "category": "Media",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {"address": "http://volumio.local", "barIcon": "cover"},
    "schema": [
      {"key": "address", "type": "string", "label": "Player address"},
      {"key": "barIcon", "type": "enum", "label": "Bar icon", "options": ["cover", "scope"], "defaultValue": "cover", "description": "Album cover art or an animated oscilloscope. Right-click the bar widget to switch."}
    ]
  }
}
